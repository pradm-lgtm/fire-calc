# Yahoo Fantasy Sports API credentials — copy to .env and fill in.
# From your registered app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the app. Defaults to
# https://localhost:8080/ — do NOT use Yahoo's legacy "oob" here: it mints
# tokens with no Fantasy scope, which 403 on every Fantasy endpoint.
YAHOO_REDIRECT_URI=https://localhost:8080/
# Leave these two blank if you don't have tokens yet — run
#   python3 yahoo_auth_check.py --auth-url
#   python3 yahoo_auth_check.py --exchange <code>
# and they'll be filled in automatically.
YAHOO_ACCESS_TOKEN=
YAHOO_REFRESH_TOKEN=
